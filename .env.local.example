# FinAccess — Environment Variables Template
# Copy this file to .env.local and populate with your actual values.
# .env.local is listed in .gitignore and will NEVER be committed to version control.

# ─── DATABASE ──────────────────────────────────────────────────────────────────
# For LOCAL DEV: SQLite (no setup needed, just run `npm run db:push`)
DATABASE_URL="file:./dev.db"

# For PRODUCTION (Vercel): Use a managed PostgreSQL provider such as:
#   - Neon       https://neon.tech  (free tier available)
#   - Supabase   https://supabase.com  (free tier available)
# When switching to PostgreSQL, also change `provider = "sqlite"` to
# `provider = "postgresql"` in prisma/schema.prisma, then run:
#   npx prisma migrate deploy
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ─── NEXTAUTH ──────────────────────────────────────────────────────────────────
# A random secret string used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="your-random-secret-here"

# NEXTAUTH_URL is set automatically by Vercel from the deployment URL.
# Only set this manually for local dev if auto-detection fails:
# NEXTAUTH_URL="http://localhost:3005"

# ─── OCR / AI VISION (for Screenshot-to-Transaction Logging) ───────────────────
# Option 1 (Recommended — 100% FREE, no credit card required):
# Google AI Studio API Key — get in 1 click at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# Option 2 (Requires Google Cloud billing account):
# GOOGLE_CLOUD_VISION_API_KEY=your_vision_key_here

# ─── EMAIL SERVICE (for Financial Signals Newsletter & Welcome Emails) ────────
# Option 1 (Recommended for Vercel): Resend (Free 3,000 emails/month)
# Get a free key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
# EMAIL_FROM="FinAccess <onboarding@resend.dev>"

# Option 2: Standard SMTP / Gmail App Password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_gmail_app_password

